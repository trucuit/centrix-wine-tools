{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CentriX Profile Snapshot v1",
  "type": "object",
  "required": [
    "version",
    "profileId",
    "exportedAt",
    "origins",
    "cookies",
    "storage"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "profileId": {
      "type": "string"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "origins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cookies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "hostOnly": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "secure": {
            "type": "boolean"
          },
          "httpOnly": {
            "type": "boolean"
          },
          "session": {
            "type": "boolean"
          },
          "expirationDate": {
            "type": [
              "number",
              "null"
            ]
          },
          "sameSite": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "storage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "localStorage": {
            "type": "object"
          },
          "sessionStorage": {
            "type": "object"
          }
        }
      }
    },
    "uiRules": {
      "type": "array"
    }
  }
}
