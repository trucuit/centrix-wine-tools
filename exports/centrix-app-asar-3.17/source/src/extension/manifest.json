{
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "author": "CentriX",
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; 'wasm-unsafe-eval' 'inline-speculation-rules'"
  },
  "content_scripts": [
    {
      "js": [
        "injected-scripts/css-inject.js",
        "vault-content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "CentriX",
  "externally_connectable": {
    "matches": [
      "<all_urls>"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "manifest_version": 3,
  "name": "CentriX",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "update_url": "https://clients2.google.com/service/update2/crx",
  "version": "1.4",
  "key": "",
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "injected-scripts/*"
      ]
    }
  ]
}
