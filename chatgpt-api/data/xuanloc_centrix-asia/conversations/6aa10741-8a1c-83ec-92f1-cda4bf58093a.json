    "eb6bcd9c-6efe-4bcd-9853-5d9a411e5fcf": {
      "id": "eb6bcd9c-6efe-4bcd-9853-5d9a411e5fcf",
      "message": {
        "id": "eb6bcd9c-6efe-4bcd-9853-5d9a411e5fcf",
        "author": {
          "role": "assistant",
          "name": null,
          "metadata": {}
