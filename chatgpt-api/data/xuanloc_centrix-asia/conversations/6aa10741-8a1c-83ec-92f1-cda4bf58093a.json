    "a1de3a95-de32-43a5-a0b7-089cec9786fe": {
      "id": "a1de3a95-de32-43a5-a0b7-089cec9786fe",
      "message": {
        "id": "a1de3a95-de32-43a5-a0b7-089cec9786fe",
        "author": {
          "role": "assistant",
          "name": null,
