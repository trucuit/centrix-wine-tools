          "content_type": "code",
          "language": "unknown",
          "response_format_name": null,
          "text": "bash -lc /bin/bash -lc \"cat > ran-san-moi.html <<'EOF'\n<\"'!doctype html>\n<html lang=\"vi\">\n<head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Rắn săn mồi • Snake Garden</title>\n<style>\n*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 15% 0%,#1d4938,transparent 55%),#0b1713;color:#edf5e8;font:16px system-ui,sans-serif;display:grid;place-items:center;padding:24px}main{width:min(100%,560px)}header{display:flex;align-items:center;justify-content:space-between;gap:16px}.eyebrow{color:#a4d888;font-size:11px;letter-spacing:3px;font-weight:700}h1{font-size:36px;letter-spacing:-1.5px;margin:6px 0}p{color:#a3b4a9;font-size:14px;line-height:1.6}.badge{border:1px solid #3b5546;border-radius:30px;padding:8px 12px;color:#b8d4ae;font-size:12px;white-space:nowrap}.stats{display:flex;gap:12px;margin:22px 0 16px}.stat{flex:1;background:#192b23;border:1px solid #304638;border-radius:16px;padding:12px 18px}.stat span{font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#a3b4a9}.stat strong{display:block;font-size:29px;margin-top:2px}.board{position:relative;overflow:hidden;border:1px solid #456047;border-radius:20px;background:#101f18;box-shadow:0 20px 60px #0004}canvas{display:block;width:100%;aspect-ratio:1;touch-action:none}.overlay{position:absolute;inset:0;display:grid;place-content:center;text-align:center;padding:24px;background:#0b1713c9;backdrop-filter:blur(3px)}.overlay[hidden]{display:none}.overlay h2{font-size:28px;margin:0}.overlay p{max-width:300px;margin:12px auto 20px}button,select{font:inherit;border-radius:12px;border:1px solid #405846;cursor:pointer;background:#20352a;color:#eef5e8;padding:12px 16px}button:hover{filter:brightness(1.16)}button:focus-visible,select:focus-visible{outline:3px solid #d2fb91;outline-offset:3px}.primary{background:#c5ef8b;color:#152414;border:0;font-weight:750}.toolbar{display:flex;gap:10px;margin:16px 0;align-items:center;flex-wrap:wrap}.toolbar label{color:#acbfb0;font-size:13px}select{flex:1;min-width:100px}.dpad{display:grid;grid-template-columns:repeat(3,52px);gap:6px;justify-content:center;margin-top:18px}.dpad button{touch-action:manipulation;padding:10px;font-size:20px}.dpad button:first-child{grid-column:2}.dpad button:nth-child(2){grid-column:1}.hint{text-align:center;font-size:12px;margin:18px 0 0;color:#91a396}@media(max-width:430px){body{padding:16px}h1{font-size:29px}.badge{display:none}.toolbar button{padding:12px}.stats{margin-top:16px}}\n</style>\n</head>\n<body>\n<main>\n<header><div><div class=\"eyebrow\">SNAKE GARDEN / 01</div><h1>Rắn săn mồi<span style=\"color:#c5ef8b\">.</span></h1></div><span class=\"badge\">● Chơi ngoại tuyến</span></header>\n<p>Ăn thật nhiều. Lớn thật nhanh. Đừng cắn đuôi!</p>\n<section class=\"stats\" aria-label=\"Điểm số\"><div class=\"stat\"><span>Điểm của bạn</span><strong id=\"score\">0</strong></div><div class=\"stat\"><span>Kỷ lục</span><strong id=\"best\">0</strong></div></section>\n<div class=\"board\"><canvas id=\"board\" width=\"600\" height=\"600\" aria-label=\"Bàn chơi rắn săn mồi\"></canvas><div class=\"overlay\" id=\"overlay\"><h2 id=\"title\">Một miếng nữa thôi!</h2><p id=\"message\">Dùng phím mũi tên, WASD hoặc vuốt trên màn hình để điều khiển rắn.</p><button class=\"primary\" id=\"play\">Bắt đầu chơi →</button></div></div>\n<div class=\"toolbar\"><label for=\"speed\">Tốc độ</label><select id=\"speed\"><option value=\"170\">Thư giãn</option><option value=\"115\" selected>Vừa sức</option><option value=\"75\">Thử thách</option></select><button id=\"pause\">Tạm dừng</button><button id=\"restart\">Chơi lại ↻</button></div>\n<div class=\"dpad\" aria-label=\"Điều khiển\"><button data-dir=\"up\" aria-label=\"Lên\">↑</button><button data-dir=\"left\" aria-label=\"Trái\">←</button><button data-dir=\"down\" aria-label=\"Xuống\">↓</button><button data-dir=\"right\" aria-label=\"Phải\">→</button></div>\n<p class=\"hint\">Mũi tên / WASD: di chuyển · Space: tạm dừng<br>Chạm tường hoặc chạm thân là kết thúc. Mỗi quả +10 điểm.</p>\n</main>\n<script>\n'\"'use strict';\nconst \"'$=id=>document.getElementById(id),canvas=$('\"'board'),ctx=canvas.getContext('2d');\nconst N=20,S=30,dirs={up:{x:0,y:-1},down:{x:0,y:1},left:{x:-1,y:0},right:{x:1,y:0}};\nlet snake,food,dir,queue=[],score=0,best=0,state='ready',timer;\ntry{best=Math.max(0,Number(localStorage.getItem('snake-garden-best'))||0)}catch{}\n\"'$('\"'best').textContent=best;\nfunction reset(){snake=[{x:9,y:10},{x:8,y:10},{x:7,y:10}];dir=dirs.right;queue=[];score=0;\"'$('\"'score').textContent=0;spawnFood();draw()}\nfunction spawnFood(){const free=[];for(let y=0;y<N;y++)for(let x=0;x<N;x++)if(\"'!snake.some(p=>p.x===x&&p.y===y))free.push({x,y});food=free[Math.floor(Math.random()*free.length)]||null}\nfunction tile(x,y,color,pad=2){ctx.fillStyle=color;ctx.beginPath();ctx.roundRect(x*S+pad,y*S+pad,S-pad*2,S-pad*2,7);ctx.fill()}\nfunction draw(){ctx.fillStyle='\"'#101f18';ctx.fillRect(0,0,600,600);ctx.strokeStyle='#ffffff06';ctx.lineWidth=1;for(let i=1;i<N;i++){ctx.beginPath();ctx.moveTo(i*S,0);ctx.lineTo(i*S,600);ctx.moveTo(0,i*S);ctx.lineTo(600,i*S);ctx.stroke()}if(food){ctx.shadowColor='#ff9479';ctx.shadowBlur=16;tile(food.x,food.y,'#ff9479',5);ctx.shadowBlur=0}snake.forEach((p,i)=>tile(p.x,p.y,i===0?'#e1ffab':i%2?'#abd875':'#99c969'));const h=snake[0];ctx.fillStyle='#21331c';for(const side of [-1,1]){ctx.beginPath();ctx.arc(h.x*S+15+dir.x*6+(dir.y?side*5:0),h.y*S+15+dir.y*6+(dir.x?side*5:0),2.5,0,Math.PI*2);ctx.fill()}}\nfunction show(title,message,button){\"'$('\"'title').textContent=title;\"'$('\"'message').textContent=message;\"'$('\"'play').textContent=button;\"'$('\"'overlay').hidden=false}\nfunction schedule(){clearTimeout(timer);if(state==='running')timer=setTimeout(tick,Number(\"'$('\"'speed').value))}\nfunction start(){clearTimeout(timer);reset();state='running';\"'$('\"'overlay').hidden=true;\"'$('\"'pause').textContent='Tạm dừng';schedule()}\nfunction end(won=false){state='over';clearTimeout(timer);show(won?'Bạn đã chinh phục khu vườn\"'!'\"':'Hết đường rồi\"'!'\"',\"'`Bạn đạt ${score} điểm. Kỷ lục: ${best} điểm.`,'\"'Chơi lại →')}\nfunction tick(){if(state\"'!=='\"'running')return;if(queue.length)dir=queue.shift();const head={x:snake[0].x+dir.x,y:snake[0].y+dir.y};const eat=food&&head.x===food.x&&head.y===food.y;const body=eat?snake:snake.slice(0,-1);if(head.x<0||head.x>=N||head.y<0||head.y>=N||body.some(p=>p.x===head.x&&p.y===head.y)){end();return}snake.unshift(head);if(eat){score+=10;\"'$('\"'score').textContent=score;if(score>best){best=score;\"'$('\"'best').textContent=best;try{localStorage.setItem('snake-garden-best',String(best))}catch{}}spawnFood()}else snake.pop();draw();if(\"'!food){end(true);return}schedule()}\nfunction steer(name){if(state!=='\"'running')return;const next=dirs[name],last=queue.length?queue[queue.length-1]:dir;if(queue.length<2&&(next.x\"'!==last.x||next.y!==last.y)&&next.x!==-last.x&&next.y!==-last.y)queue.push(next)}\nfunction pause(){if(state==='\"'running'){state='paused';clearTimeout(timer);\"'$('\"'pause').textContent='Tiếp tục';show('Nghỉ một chút','Khu vườn vẫn đang đợi bạn.','Tiếp tục →')}else if(state==='paused'){state='running';\"'$('\"'overlay').hidden=true;\"'$('\"'pause').textContent='Tạm dừng';schedule()}}\n\"'$('\"'play').onclick=()=>state==='paused'?pause():start();\"'$('\"'restart').onclick=start;\"'$('\"'pause').onclick=pause;\"'$('\"'speed').onchange=schedule;\ndocument.querySelectorAll('[data-dir]').forEach(b=>b.onclick=()=>steer(b.dataset.dir));\ndocument.addEventListener('keydown',e=>{if(['SELECT','INPUT','TEXTAREA'].includes(e.target.tagName))return;const keys={ArrowUp:'up',w:'up',ArrowDown:'down',s:'down',ArrowLeft:'left',a:'left',ArrowRight:'right',d:'right'};const k=keys[e.key]||keys[e.key.toLowerCase()];if(k){e.preventDefault();steer(k)}else if(e.code==='Space'&&e.target.tagName\"'!=='\"'BUTTON'){e.preventDefault();if(state==='ready'||state==='over')start();else pause()}});\nlet touch=null;canvas.addEventListener('pointerdown',e=>{touch={x:e.clientX,y:e.clientY};canvas.setPointerCapture(e.pointerId)});canvas.addEventListener('pointerup',e=>{if(\"'!touch)return;const dx=e.clientX-touch.x,dy=e.clientY-touch.y;touch=null;if(Math.max(Math.abs(dx),Math.abs(dy))>15)steer(Math.abs(dx)>Math.abs(dy)?dx>0?'\"'right':'left':dy>0?'down':'up')});canvas.addEventListener('pointercancel',()=>touch=null);\ndocument.addEventListener('visibilitychange',()=>{if(document.hidden&&state==='running')pause()});reset();\n</script>\n</body></html>\nEOF\nnode -e \\\"const fs=require('fs');const s=fs.readFileSync('ran-san-moi.html','utf8').match(/<script>([\\\\\\\\s\\\\\\\\S]*?)<\\\\/script>/)[1];new Function(s);console.log('JavaScript syntax OK');\\\"\""
