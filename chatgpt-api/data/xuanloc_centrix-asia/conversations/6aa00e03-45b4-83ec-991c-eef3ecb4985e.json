          "text": "bash -lc /bin/bash -lc \"cat > /workspace/scratch/ece10c3a7860/ran-san-moi.html <<'EOF'\n<\"'!DOCTYPE html>\n<html lang=\"vi\">\n<head>\n<meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Rắn săn mồi</title>\n<style>\n*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;background:radial-gradient(ellipse at top,#193d36,#091713 70%);color:#edf9ef;font-family:system-ui,sans-serif;padding:24px}main{width:min(100%,520px)}.tag{color:#9ddc9c;text-transform:uppercase;font-size:11px;letter-spacing:3px}h1{font-size:36px;margin:8px 0}p{color:#a5b9ae;font-size:14px;line-height:1.6}.stats{display:flex;gap:12px;margin:22px 0 16px}.stat{flex:1;background:#ffffff08;border:1px solid #ffffff12;border-radius:16px;padding:14px 20px}.stat span{display:block;color:#a5b9ae;font-size:12px}.stat strong{font-size:28px}.board{position:relative;border:1px solid #ffffff20;border-radius:20px;overflow:hidden;box-shadow:0 24px 80px #0005}canvas{display:block;width:100%;aspect-ratio:1;background:#10251e;touch-action:none}.overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;background:#081910da;padding:20px;backdrop-filter:blur(4px)}.overlay[hidden]{display:none}h2{margin:10px 0;font-size:28px}.icon{font-size:44px}.actions{display:flex;gap:10px;margin-top:16px}button,select{font:inherit;border:1px solid #ffffff24;border-radius:12px;padding:12px 16px;color:#edf9ef;background:#20372e;cursor:pointer}button:hover{filter:brightness(1.2)}button:focus-visible,select:focus-visible{outline:3px solid #c4f88d;outline-offset:3px}.primary{background:#bbef83;color:#19331b;border:0;font-weight:700}#pause{flex:1}select{max-width:145px}button:disabled{opacity:.45;cursor:default}.pad{display:grid;grid-template-columns:repeat(3,52px);gap:6px;justify-content:center;margin-top:18px}.pad button{padding:10px;touch-action:manipulation;user-select:none}.pad button:first-child{grid-column:2}.pad button:nth-child(2){grid-column:1}.help{text-align:center;font-size:12px;margin-bottom:0}@media(max-width:420px){body{padding:16px}h1{font-size:30px}.actions{flex-wrap:wrap}button,select{padding:11px 12px}}\n</style>\n</head>\n<body><main>\n<div class=\"tag\">Mini arcade · Chơi offline</div><h1>Rắn săn mồi<span style=\"color:#bbef83\">.</span></h1><p>Ăn mồi, lớn lên và chinh phục kỷ lục của anh.</p>\n<div class=\"stats\"><div class=\"stat\"><span>ĐIỂM HIỆN TẠI</span><strong id=\"score\">0</strong></div><div class=\"stat\"><span>KỶ LỤC</span><strong id=\"best\">0</strong></div></div>\n<div class=\"board\"><canvas id=\"game\" width=\"600\" height=\"600\" aria-label=\"Bàn chơi rắn săn mồi\"></canvas><div class=\"overlay\" id=\"overlay\"><div class=\"icon\">🐍</div><h2 id=\"title\">Sẵn sàng chưa?</h2><p id=\"message\">Tránh tường và đừng cắn vào chính mình.</p><button class=\"primary\" id=\"start\">Bắt đầu chơi</button></div></div>\n<div class=\"actions\"><button id=\"pause\" disabled>Tạm dừng</button><button id=\"restart\">Chơi lại</button><select id=\"speed\" aria-label=\"Độ khó\"><option value=\"180\">Dễ</option><option value=\"125\" selected>Vừa</option><option value=\"80\">Khó</option></select></div>\n<div class=\"pad\" aria-label=\"Điều khiển\"><button data-dir=\"up\" aria-label=\"Lên\">↑</button><button data-dir=\"left\" aria-label=\"Trái\">←</button><button data-dir=\"down\" aria-label=\"Xuống\">↓</button><button data-dir=\"right\" aria-label=\"Phải\">→</button></div>\n<p class=\"help\">Phím mũi tên / WASD để di chuyển · Space để tạm dừng<br>Điện thoại: vuốt trên bàn chơi hoặc bấm nút mũi tên.</p>\n</main>\n<script>\n'\"'use strict';\nconst \"'$=id=>document.getElementById(id),canvas=$('\"'game'),ctx=canvas.getContext('2d'),N=20,C=30;\nconst dirs={up:{x:0,y:-1},down:{x:0,y:1},left:{x:-1,y:0},right:{x:1,y:0}};\nlet snake,food,dir,queue=[],score=0,best=0,state='ready',timer=null;\ntry{best=Math.max(0,Number(localStorage.getItem('snake-best'))||0)}catch{}\"'$('\"'best').textContent=best;\nfunction spawn(){const free=[];for(let y=0;y<N;y++)for(let x=0;x<N;x++)if(\"'!snake.some(s=>s.x===x&&s.y===y))free.push({x,y});return free.length?free[Math.floor(Math.random()*free.length)]:null}\nfunction reset(){snake=[{x:7,y:10},{x:6,y:10},{x:5,y:10}];dir=dirs.right;queue=[];score=0;$('\"'score').textContent=0;food=spawn();draw()}\nfunction clock(){clearInterval(timer);timer=setInterval(tick,Number(\"'$('\"'speed').value))}\nfunction start(){reset();state='playing';\"'$('\"'overlay').hidden=true;\"'$('\"'pause').disabled=false;\"'$('\"'pause').textContent='Tạm dừng';clock()}\nfunction overlay(title,message,label){\"'$('\"'title').textContent=title;\"'$('\"'message').textContent=message;\"'$('\"'start').textContent=label;\"'$('\"'overlay').hidden=false}\nfunction pause(){if(state==='playing'){state='paused';clearInterval(timer);\"'$('\"'pause').textContent='Tiếp tục';overlay('Tạm nghỉ một chút','Nhấn Space hoặc Tiếp tục để chơi tiếp.','Tiếp tục')}else if(state==='paused'){state='playing';\"'$('\"'overlay').hidden=true;\"'$('\"'pause').textContent='Tạm dừng';clock()}}\nfunction turn(name){if(state\"'!=='\"'playing'||queue.length>=2)return;const next=dirs[name],last=queue.length?queue[queue.length-1]:dir;if(next.x===-last.x&&next.y===-last.y||next.x===last.x&&next.y===last.y)return;queue.push(next)}\nfunction finish(won=false){clearInterval(timer);state='over';\"'$('\"'pause').disabled=true;overlay(won?'Anh thắng rồi\"'!'\"':'Hết lượt rồi\"'!'\"',\"'`Anh đạt ${score} điểm. Kỷ lục: ${best} điểm.`,'\"'Chơi lại')}\nfunction tick(){if(state\"'!=='\"'playing')return;if(queue.length)dir=queue.shift();const head={x:snake[0].x+dir.x,y:snake[0].y+dir.y};const eat=food&&head.x===food.x&&head.y===food.y;const body=eat?snake:snake.slice(0,-1);if(head.x<0||head.x>=N||head.y<0||head.y>=N||body.some(s=>s.x===head.x&&s.y===head.y)){finish();return}snake.unshift(head);if(eat){score+=10;\"'$('\"'score').textContent=score;if(score>best){best=score;\"'$('\"'best').textContent=best;try{localStorage.setItem('snake-best',String(best))}catch{}}food=spawn();if(\"'!food){draw();finish(true);return}}else snake.pop();draw()}\nfunction draw(){ctx.clearRect(0,0,600,600);ctx.strokeStyle='\"'#ffffff05';ctx.lineWidth=1;for(let i=1;i<N;i++){ctx.beginPath();ctx.moveTo(i*C,0);ctx.lineTo(i*C,600);ctx.stroke();ctx.beginPath();ctx.moveTo(0,i*C);ctx.lineTo(600,i*C);ctx.stroke()}if(food){ctx.shadowColor='#ff8971';ctx.shadowBlur=16;ctx.fillStyle='#ff8971';ctx.beginPath();ctx.arc(food.x*C+15,food.y*C+15,9,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0}snake.forEach((s,i)=>{ctx.fillStyle=i===0?'#d3ffa6':\"'`hsl(100,55%,${Math.max(36,64-i*.7)}%)`;ctx.beginPath();ctx.roundRect(s.x*C+2,s.y*C+2,C-4,C-4,i===0?9:6);ctx.fill()});const h=snake[0],px=-dir.y,py=dir.x;ctx.fillStyle='\"'#19331b';for(const sign of [-1,1]){ctx.beginPath();ctx.arc(h.x*C+15+dir.x*6+px*5*sign,h.y*C+15+dir.y*6+py*5*sign,2.5,0,Math.PI*2);ctx.fill()}}\n\"'$('\"'start').onclick=()=>state==='paused'?pause():start();\"'$('\"'restart').onclick=start;\"'$('\"'pause').onclick=pause;\"'$('\"'speed').onchange=()=>{if(state==='playing')clock()};\nconst keys={ArrowUp:'up',ArrowDown:'down',ArrowLeft:'left',ArrowRight:'right',w:'up',s:'down',a:'left',d:'right'};\ndocument.addEventListener('keydown',e=>{if(e.target.tagName==='SELECT')return;const name=keys[e.key]||keys[e.key.toLowerCase()];if(name){e.preventDefault();turn(name)}else if(e.code==='Space'&&e.target.tagName\"'!=='\"'BUTTON'){e.preventDefault();if(e.repeat)return;if(state==='ready'||state==='over')start();else pause()}});\ndocument.querySelectorAll('[data-dir]').forEach(b=>b.onclick=()=>turn(b.dataset.dir));let touch=null;canvas.addEventListener('pointerdown',e=>{touch={x:e.clientX,y:e.clientY};canvas.setPointerCapture(e.pointerId)});canvas.addEventListener('pointerup',e=>{if(\"'!touch)return;const dx=e.clientX-touch.x,dy=e.clientY-touch.y;touch=null;if(Math.max(Math.abs(dx),Math.abs(dy))<12)return;turn(Math.abs(dx)>Math.abs(dy)?dx>0?'\"'right':'left':dy>0?'down':'up')});canvas.addEventListener('pointercancel',()=>touch=null);document.addEventListener('visibilitychange',()=>{if(document.hidden&&state==='playing')pause()});reset();\n</script></body></html>\nEOF\nnode -e \\\"const fs=require('fs');const html=fs.readFileSync('/workspace/scratch/ece10c3a7860/ran-san-moi.html','utf8');new Function(html.match(/<script>([\\\\\\\\s\\\\\\\\S]*?)<\\\\\\\\/script>/)[1]);console.log('JavaScript syntax OK')\\\"\""
