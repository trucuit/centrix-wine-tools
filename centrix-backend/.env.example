# CentriX backend configuration template.
# Copy to .env and set secrets through your deployment secret manager.

# Runtime
CENTRIX_BACKEND_HOST=127.0.0.1
CENTRIX_BACKEND_PORT=18778
CENTRIX_BACKEND_WORKERS=1
CENTRIX_BACKEND_DATA_DIR=/opt/centrix/data
CENTRIX_BACKEND_WEB_DIR=
CENTRIX_RELEASE_DIR=

# Database API / local SQLite
CENTRIX_LOCAL_DB_URL=http://127.0.0.1:19779
CENTRIX_LOCAL_DB_TIMEOUT_MS=10000
CENTRIX_LOCAL_DB_RETRY_MS=250
CENTRIX_DB_CACHE_TTL_MS=5000
CENTRIX_LOCAL_DB_MODE=sqlite
CENTRIX_DB_HOST=
CENTRIX_DB_PORT=
CENTRIX_DB_PATH=/opt/centrix/data/centrix-local-db.sqlite
CENTRIX_READDB_TTL_S=5

# User authentication and session security
CENTRIX_REMOTE_TOKEN=REPLACE_WITH_A_RANDOM_SECRET
CENTRIX_REMOTE_REQUIRE_TOKEN=1
CENTRIX_AUTH_TTL_MS=604800000
CENTRIX_BIND_SESSION_KEY=1
CENTRIX_COOKIE_SECURE=1
CENTRIX_DISABLE_PWD_LOGIN=1
CENTRIX_PW_ITERS=210000
CENTRIX_REQUIRE_ROTATED_KEYS=1

# Google sign-in
CENTRIX_GOOGLE_CLIENT_ID=
CENTRIX_GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# App attestation and protected profile export
CENTRIX_APP_KEY=REPLACE_WITH_APP_KEY
CENTRIX_APP_ATTEST_SECRET=REPLACE_WITH_APP_ATTEST_SECRET
CENTRIX_EXPORT_GATE=1
CENTRIX_EXPORT_REQUIRE_SIG=1
CENTRIX_EXPORT_SIGN_KEY=REPLACE_WITH_EXPORT_SIGNING_KEY
CENTRIX_EXPORT_SIG_WINDOW_MS=300000
CENTRIX_EXPORT_INTERACT_TTL_MS=300000
CENTRIX_ALLOW_PLAINTEXT_SNAPSHOT=0
CENTRIX_TRACE_EXPORT=0

# Profile pool and worker integration
CENTRIX_POOL_CAPACITY=1
CENTRIX_POOL_TTL_MS=900000
CENTRIX_PROFILE_FROM_DB=1
CENTRIX_PROFILE_SINGLE_DEVICE=0
CENTRIX_PROFILE_VIA_WORKER=0
CENTRIX_LOADER_VIA_WORKER=0
CENTRIX_WORKER_RPC_URL=
CENTRIX_WORKER_RPC_SECRET=REPLACE_WITH_WORKER_RPC_SECRET
CENTRIX_SLOT_COOLDOWN_MS=0
CENTRIX_SLOT_COOLDOWN_MAX_MS=0
CENTRIX_AUTO_RESEED=0
CENTRIX_RESEED_TTL_MS=900000
CENTRIX_RESEED_COOLING_MS=0
CENTRIX_SEED_PW=REPLACE_WITH_SEED_PASSWORD
CENTRIX_SELFTEST_USER=
CENTRIX_SELFTEST_PW=REPLACE_WITH_SELFTEST_PASSWORD

# Encrypted profile snapshots and service vault
CENTRIX_MASTER_SNAPSHOT_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
CENTRIX_SNAPSHOT_AT_REST_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
CENTRIX_SNAPSHOT_DIR=/opt/centrix/data/snapshots
CENTRIX_VAULT_FILE=/opt/centrix/data/service-vault.json
CENTRIX_VAULT_KEY=REPLACE_WITH_VAULT_KEY

# Staff/admin access
CENTRIX_STAFF_RBAC=on
CENTRIX_STAFF_SESSION_SECRET=REPLACE_WITH_STAFF_SESSION_SECRET
CENTRIX_STAFF_TTL_MS=28800000
CENTRIX_STAFF_PERM_TTL_MS=300000
CENTRIX_STAFF_OWNER_EMAIL=
CENTRIX_STAFF_OWNER_PW=REPLACE_WITH_OWNER_PASSWORD

# Plans, quotas, and model handling
CENTRIX_PLAN_GATE=1
CENTRIX_MAX_TOKENS_PER_REQUEST=0
CENTRIX_STRIP_MODEL_EFFORT=0
CENTRIX_ALLOW_UI_USERSCRIPT=0
CENTRIX_UPLOAD_MAX_MB=25

# SePay / VietQR
CENTRIX_SEPAY_SECRET=REPLACE_WITH_SEPAY_SECRET
CENTRIX_SEPAY_MAX_SKEW_SEC=300
CENTRIX_VIETQR_ENABLED=0
CENTRIX_VIETQR_ACCOUNT=
CENTRIX_VIETQR_BIN=
CENTRIX_VIETQR_CODE=
CENTRIX_VIETQR_NAME=
CENTRIX_VIETQR_TEMPLATE=

# Production-only compatibility flags
CENTRIX_RESERVE_LEDGER=0
CENTRIX_RESERVE_LEDGER_USERS=
